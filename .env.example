DATABASE_URL="mysql://app:apppassword@localhost:3306/pase_de_lista"
JWT_SECRET="llave_secreata"
JWT_EXPIRES_IN="8h"
PORT=3000

# ========================================
# Firebase Cloud Messaging (FCM) para Push
# ========================================
# Obtener estos valores del JSON de Firebase Service Account:
# Firebase Console → Project Settings → Service Accounts → "Generate new private key"

# project_id (ej: "asistencia-df0f2")
FCM_PROJECT_ID="TU_PROJECT_ID"

# client_email (ej: "firebase-adminsdk-xxxxx@asistencia-df0f2.iam.gserviceaccount.com")
FCM_SERVICE_ACCOUNT_EMAIL="TU_SERVICE_ACCOUNT_EMAIL"

# private_key (todo el contenido del campo "private_key", con saltos de línea reales)
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# private_key_id (campo "private_key_id")
FCM_PRIVATE_KEY_ID="TU_PRIVATE_KEY_ID"